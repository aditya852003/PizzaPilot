/**
 * PRODUCTION SECURITY RULES
 * - Hardened to prevent client-side write access to sensitive collections.
 * - Subscriptions can only be read by the owner, writes are restricted to Admin SDK (API).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // == Helper Functions ==
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRoleOwner() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // == Rules per Collection ==

    match /users/{userId} {
      allow get: if isRoleOwner() || isOwner(userId);
      allow list: if isRoleOwner();
      allow create: if isOwner(userId);
      allow update: if (isRoleOwner() || isOwner(userId)) && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /subscriptions/{subscriptionId} {
        // Users can read their own subscriptions.
        allow get, list: if isOwner(userId) || isRoleOwner();
        
        // SECURITY UPGRADE: Direct client writes are now forbidden.
        // Subscriptions MUST be created via the /api/subscribe route (Admin SDK).
        allow write: if false;
      }
      
      match /checkout_sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isRoleOwner();
      }
    }

    match /orders/{orderId} {
      allow read, write: if isRoleOwner();
      allow create: if isOwner(request.resource.data.userId);
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && request.query.where[0][2] == request.auth.uid;
      allow delete: if false;
      allow update: if isOwner(resource.data.userId) && request.resource.data.status == 'cancelled';
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow write: if isRoleOwner();
    }
    
    match /metadata/{docId} {
       allow read: if isSignedIn();
       allow write: if isRoleOwner();
    }
  }
}
